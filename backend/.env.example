# =========================================================================
# MedNova Backend -- environment template
#
# Copy to `backend/.env` and fill in the real values:
#     cp backend/.env.example backend/.env
#
# `backend/.env` is gitignored and is loaded by app/core/config.py:10 via
# load_dotenv(). It is read ONCE at import, so restart the server after editing.
# Every value below is read through os.getenv() -- names must match exactly.
# =========================================================================


# ---- Application --------------------------------------------------------
# development | production. Controls logging verbosity and is echoed by /health.
ENVIRONMENT=development
# true | false. Leave false in production.
DEBUG=true


# ---- Supabase: project ---------------------------------------------------
# Project URL, e.g. https://abcdefghijklm.supabase.co
SUPABASE_URL=https://your-project-ref.supabase.co

# JWKS endpoint used to verify access tokens locally. Normally:
#   ${SUPABASE_URL}/auth/v1/.well-known/jwks.json
# Tokens are verified against the algorithm the JWKS key itself declares, so this
# works whether the project signs with ES256 or RS256.
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json

# Public client key. Either name works -- SUPABASE_ANON_KEY wins if both are set.
# Legacy projects: the anon JWT. Newer projects: the sb_publishable_... key.
SUPABASE_ANON_KEY=

# SECRET -- service-role key. Grants full admin access to your project, including
# auth.admin user creation and deletion. Never ship this to a client or a browser
# bundle; it belongs on the server only.
# Either name works -- SUPABASE_SERVICE_ROLE_KEY wins if both are set.
SUPABASE_SERVICE_ROLE_KEY=

# Aliases config.py also accepts for the two keys above. Set EITHER the names
# above OR these -- not both. Listed so this template covers every name the code
# reads (config.py:22-23).
#SUPABASE_PUBLISHABLE_KEY=
#SUPABASE_SECRET_KEY=


# ---- Supabase: database --------------------------------------------------
# SECRET -- full Postgres connection string, read into settings.DATABASE_URL.
#
# IMPORTANT for IPv4-only hosts (Render, most CI, many container platforms):
# the DIRECT host `db.<ref>.supabase.co` resolves IPv6-ONLY. From an IPv4-only
# host every query fails with "[Errno 101] Network is unreachable" while /health
# still returns 200, because /health is the only route that skips the database.
# Use the connection pooler instead -- note the different host AND username
# (`postgres.<project-ref>`), not just a different port:
#
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
#
# Port 5432 = session mode (recommended). Port 6543 = transaction mode; both work
# with this app's asyncpg engine on Supabase's Supavisor pooler.
# URL-encode any special characters in the password.
SUPABASE_CONNECTION_URL=postgresql://postgres.your-project-ref:your-password@aws-0-your-region.pooler.supabase.com:5432/postgres


# ---- Gemini: patient summary reports -------------------------------------
# OPTIONAL. Powers the narrative paragraph in the downloadable patient summary
# (POST /api/v1/patients/{id}/report). Get a key at https://aistudio.google.com/apikey
#
# Without a key the report still generates using a deterministic narrative, and
# the document header reads "Rule-based (Gemini unavailable)" instead of naming
# the model. Gemini writes ONLY the prose -- every clinical fact in the report is
# assembled from the database, so the model can never invent a vital sign.
GEMINI_API_KEY=

# A flash model keeps generation inside the request instead of needing a job queue.
GEMINI_MODEL=gemini-2.0-flash

# Seconds before the Gemini call is abandoned and the fallback narrative is used.
GEMINI_TIMEOUT_SECONDS=12


# ---- Push notifications (Firebase) ---------------------------------------
# Optional. Absolute or relative path to the FCM service-account JSON.
FCM_PROJECT_ID=mednova-fcm
FCM_CREDENTIALS_PATH=


# ---- Security ------------------------------------------------------------
# Comma-separated allowed origins. "*" reflects any origin -- acceptable for local
# development, but pin it to your real front-end domains in production, e.g.
#   BACKEND_CORS_ORIGINS=https://admin.yourhospital.org,https://app.yourhospital.org
BACKEND_CORS_ORIGINS=*


# ---- AI risk model -------------------------------------------------------
# Path to the TFLite ventilator risk model. If the file or the tflite runtime is
# missing, AIService falls back to its heuristic estimator automatically.
AI_MODEL_PATH=app/ai/models/ventilator_risk_v1.tflite
