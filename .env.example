# Stitch MCP Environment Configuration

# The API key generated from Google Stitch settings
STITCH_API_KEY=your_stitch_api_key_here

# Your Google Stitch Project ID
STITCH_PROJECT_ID=your_stitch_project_id_here

# Your Google Stitch Workspace ID (optional)
STITCH_WORKSPACE_ID=your_stitch_workspace_id_here

# Custom Stitch Base URL (optional, defaults to Google Stitch production API)
STITCH_BASE_URL=https://stitch.googleapis.com

# Path to Google Cloud Service Account JSON credentials (if using Service Account auth)
GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json
